{
  "name": "invoice-reimbursement",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "node scripts/sync-version.mjs && tauri build --no-bundle && pwsh -File scripts/create-portable.ps1",
    "tauri:build:fast": "node scripts/sync-version.mjs && tauri build --no-bundle -- --profile release-fast && pwsh -File scripts/create-portable.ps1 release-fast",
    "tauri:build:installer": "node scripts/sync-version.mjs && tauri build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.35",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@vueuse/core": "^14.4.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.0.0"
  }
}
