{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/v2/core/tauri-config-schema/schema.json",
  "productName": "发票报销助手",
  "version": "0.1.0",
  "identifier": "com.invoice-reimbursement.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "发票报销助手",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**", "$DOWNLOAD/**", "$HOME/**"],
        "deny": []
      }
    }
  }
}
