{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/v2/core/tauri-config-schema/schema.json",
  "productName": "InvoiceAssistant",
  "version": "1.2.0",
  "identifier": "com.invoice-reimbursement.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/smart-frontend-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InvoiceAssistant v1.2.0",
        "label": "main",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "发票识别与报销管理助手",
    "longDescription": "发票报销助手是一款基于 Tauri + Vue 3 的桌面应用，支持发票 OCR 识别、报销单管理、Excel 导入导出和 PDF 报表生成。",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQTc2OTE3RTBGRTdDQjQKUldTMGZQN2dGMm1udWhDWlk5V0V0Zm1ZdU5pVGYxWFJQNjBwNGMzNHVmUWxQSVhHYndLQjh2NlMK",
      "endpoints": [
        "https://github.com/chenfuxu920/invoice-reimbursement/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
